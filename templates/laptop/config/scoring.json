{
  "rules_version": "scoring-3",
  "rules": [
    {
      "primitive": 1,
      "name": "Instruction",
      "base": {
        "kind": "run.open"
      },
      "levels": [
        {
          "level": 3,
          "requires": [
            {
              "kind": "run.open",
              "pointer": "/instruction_pack",
              "present": true
            }
          ],
          "evidence": "instruction pack version-pinned on every run.open"
        },
        {
          "level": 4,
          "requires": [
            {
              "kind": "sensor.verdict",
              "pointer": "/sensor",
              "equals": "instruction-lifecycle"
            }
          ],
          "evidence": "the instruction-lifecycle sensor gated the pack: a change is checked against a review record, which is lifecycle telemetry rather than version pinning alone. The predicate names the sensor and not its outcome, because what earns the level is that the control ran, never that it failed."
        }
      ]
    },
    {
      "primitive": 2,
      "name": "Context delivery",
      "base": {
        "kind": "model.call"
      },
      "levels": [
        {
          "level": 3,
          "requires": [
            {
              "kind": "model.call",
              "pointer": "/prompt_hash",
              "present": true
            }
          ],
          "evidence": "normalised model.call events with a pinned prompt hash"
        }
      ]
    },
    {
      "primitive": 3,
      "name": "Context management",
      "base": {
        "kind": "model.call"
      },
      "levels": [
        {
          "level": 2,
          "requires": [
            {
              "kind": "model.call",
              "pointer": "/window",
              "present": true
            }
          ],
          "evidence": "window budget and actual recorded per call"
        },
        {
          "level": 3,
          "requires": [
            {
              "kind": "graph.query",
              "pointer": "/bytes_read",
              "present": true
            }
          ],
          "evidence": "graph retrieval ledgered with its byte cost and staleness re-reads"
        }
      ]
    },
    {
      "primitive": 4,
      "name": "Tool interface",
      "base": {
        "kind": "tool.request"
      },
      "levels": [
        {
          "level": 3,
          "requires": [
            {
              "kind": "tool.register"
            }
          ],
          "evidence": "MCP-shaped registry emits register verdicts"
        },
        {
          "level": 4,
          "requires": [
            {
              "kind": "tool.result",
              "pointer": "/taint",
              "equals": true
            }
          ],
          "evidence": "tool results carry taint"
        }
      ]
    },
    {
      "primitive": 5,
      "name": "Execution environment",
      "base": {
        "kind": "tool.request"
      },
      "levels": [
        {
          "level": 4,
          "requires": [
            {
              "kind": "tool.request",
              "pointer": "/sandbox",
              "equals": "seatbelt"
            }
          ],
          "evidence": "commands run inside a seatbelt sandbox, recorded per request"
        }
      ]
    },
    {
      "primitive": 6,
      "name": "Durable state",
      "base": {
        "kind": "state.checkpoint"
      },
      "levels": [
        {
          "level": 2,
          "requires": [
            {
              "kind": "state.checkpoint"
            }
          ],
          "evidence": "checkpoints on the ledger"
        },
        {
          "level": 3,
          "requires": [
            {
              "kind": "run.open",
              "pointer": "/restored_checkpoint",
              "present": true
            }
          ],
          "evidence": "a run resumed from a checkpoint: the seam is on the record"
        }
      ]
    },
    {
      "primitive": 7,
      "name": "Orchestration",
      "base": {
        "kind": "capability.run"
      },
      "levels": [
        {
          "level": 2,
          "requires": [
            {
              "kind": "capability.run"
            }
          ],
          "evidence": "capability runs recorded"
        },
        {
          "level": 3,
          "requires": [
            {
              "kind": "rung.change",
              "pointer": "/approver",
              "present": true
            }
          ],
          "evidence": "a rung earned promotion under a named approver"
        },
        {
          "level": 4,
          "requires": [
            {
              "kind": "policy.decision",
              "pointer": "/verdict",
              "equals": "hold"
            },
            {
              "kind": "approval",
              "pointer": "/call_hash",
              "present": true
            }
          ],
          "evidence": "a human gate ran at an irreversible step: the policy held a call before it executed, and a human answered that call on the record. The predicates name the gate firing and an answer existing, never which answer it was: a refusal is the gate working, and a rule that scored an approval higher than a refusal would pay for saying yes. The answer is matched on call_hash because the same event kind also carries a rung promotion's approval, which every ledger reaching level 3 already has, and a predicate satisfied by that would credit level 4 for level 3's evidence."
        }
      ]
    },
    {
      "primitive": 8,
      "name": "Sub-agents",
      "base": {
        "kind": "subagent.spawn"
      },
      "levels": [
        {
          "level": 3,
          "requires": [
            {
              "kind": "subagent.spawn"
            }
          ],
          "evidence": "sub-agents with narrowed scope"
        }
      ]
    },
    {
      "primitive": 9,
      "name": "Skills",
      "base": {
        "kind": "skill.resolve"
      },
      "levels": [
        {
          "level": 3,
          "requires": [
            {
              "kind": "skill.resolve"
            }
          ],
          "evidence": "signed skill resolution"
        }
      ]
    },
    {
      "primitive": 10,
      "name": "Verification",
      "base": {
        "kind": "sensor.verdict"
      },
      "levels": [
        {
          "level": 3,
          "requires": [
            {
              "kind": "sensor.verdict"
            }
          ],
          "evidence": "sensor verdicts on the ledger"
        },
        {
          "level": 4,
          "requires": [
            {
              "kind": "sensor.verdict",
              "pointer": "/verdict",
              "equals": "broken"
            }
          ],
          "evidence": "a sensor that could not fail was reported broken, not clean"
        }
      ]
    },
    {
      "primitive": 11,
      "name": "Observability",
      "base": {
        "kind": "tool.request"
      },
      "levels": [
        {
          "level": 3,
          "requires": [
            {
              "kind": "tool.result"
            },
            {
              "kind": "policy.decision"
            }
          ],
          "evidence": "requests, decisions and results all flow through the chokepoint onto the signed ledger"
        }
      ]
    },
    {
      "primitive": 12,
      "name": "Governance",
      "base": {
        "kind": "policy.decision"
      },
      "levels": [
        {
          "level": 2,
          "requires": [
            {
              "kind": "policy.decision",
              "pointer": "/rule",
              "present": true
            }
          ],
          "evidence": "every decision names its rule"
        },
        {
          "level": 3,
          "requires": [
            {
              "kind": "policy.decision",
              "pointer": "/verdict",
              "equals": "deny"
            }
          ],
          "evidence": "authority-as-code produced a named denial; permission-mode divergence is recorded per event when the host exposes the mode, unobserved otherwise"
        },
        {
          "level": 4,
          "requires": [
            {
              "kind": "drift.report"
            },
            {
              "kind": "run.open",
              "pointer": "/unavailable",
              "present": true
            }
          ],
          "evidence": "the declaration is checked against the running system rather than assumed: gantry drift walked the profile requirements and reported one event per field, and every run open recorded which declared requirements this machine could not provide (an empty list when it provided them all, which is why the list is never absent). Both predicates name the walk having run, never what it found: a ledger of matches and a ledger of divergences are the same control working, and scoring them differently would pay for breakage."
        }
      ]
    }
  ]
}
